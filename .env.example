# ---------------------------------------------------------------------------
# Emavanta — copy this file to `.env` (same folder) and fill it in.
# Only the Node.js backend loads this file. Keep it private; frontend settings are separate.
# ---------------------------------------------------------------------------

# Demo login, mock sending and seeding are available in automated tests only.
# It does NOT decide where data is stored — MONGODB_URI does.
DEMO_MODE=false
NODE_ENV=development

# Ports (optional)
PORT=4000

# ---------------------------------------------------------------------------
# MongoDB Atlas  ← the database
#
# 1. Atlas → Database Access → Add New Database User
#      Username: emavanta      Auth: password (save it)
# 2. Atlas → Network Access → Add IP Address
#      Allow only the IPs needed by your server.
# 3. Atlas → Database → Connect → Drivers → Node.js → copy the string.
#    It looks like:
#      mongodb+srv://emavanta:<db_password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# 4. Paste it below and replace <db_password>.
#
# Notes
#  * Put the database name in the path — recommended:
#      mongodb+srv://emavanta:PASSWORD@cluster0.abcde.mongodb.net/emavanta?retryWrites=true&w=majority
#    Without a path the app uses the name in MONGODB_DB, or "emavanta".
#  * If your password contains  @ : / ? # [ ] %  URL-encode it
#    (@ → %40   # → %23   % → %25   ? → %3F), or use a password with letters+digits only.
#  * Your usual "local" alternative: mongodb://127.0.0.1:27017/emavanta
#  * Leave MONGODB_URI empty to run on the in-memory store (demo only, resets on restart).
#  * Verify the connection any time with:  npm run db:check
# ---------------------------------------------------------------------------
MONGODB_URI=
# MONGODB_DB=emavanta
# MONGODB_TIMEOUT_MS=8000
# MONGODB_MAX_POOL=20
# A configured but unreachable MongoDB fails startup rather than falling back to memory.

# ---------------------------------------------------------------------------
# Secrets — generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-super-secret-32-chars-minimum
ENCRYPTION_KEY=change-me-32-byte-hex-key-00000000000000000000000000000000

# Background jobs remain in MongoDB. Optional Upstash Redis REST shared rate limits:
# Set URL/token on ALL API and worker processes to the same Upstash database. Until configured, sending is blocked.
# Never expose the REST token to the frontend or commit it.
RATE_LIMIT_BACKEND=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Run npm run redis:check to test PING and a short-lived Lua operation. Redis outages pause rate-limited work.
# Without MongoDB jobs are in-memory and not durable.
# QUEUE_POLL_MS=2000
# QUEUE_LEASE_MS=60000
# WORKER_CONCURRENCY=1

# Experimental in-dashboard Stripe card payments; enable only after security and live testing.
# Both keys must be from the same Stripe account and mode. Never put the secret key in frontend settings.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PUBLIC FRONTEND origin (different from the backend domain). Replace this example.
# This variable is required in production, and drives CORS and public links.
# The backend public domain goes in frontend/.env as API_ORIGIN, not here.
# Used by password recovery, hosted-form links, and default email tracking links.
APP_URL=https://app.example.com
# Optional comma-separated extra exact browser origins; no paths or wildcard.
# The normal frontend uses its own same-origin proxy. Public embedded forms may
# be posted from third-party websites without credentials.
CORS_ALLOWED_ORIGINS=
# Optional public tracking origin. Leave blank to use APP_URL and its /t, /u proxy.
# TRACKING_BASE_URL=https://app.example.com
# OAuth is currently disabled; when implemented, configure this as the API origin.
OAUTH_REDIRECT_BASE=https://api.example.com

# OAuth is disabled until sender identity handling is implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Transactional email for signup OTP (use real SMTP credentials; do not commit .env)
# Optional Hostinger preset: fills SMTP_HOST and SMTP_FROM from SMTP_USER if blank.
SMTP_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# If SMTP_HOST is an IP, use the provider certificate hostname for TLS validation.
# SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# BNB Chain / USDT. Experimental; keep disabled until independently reviewed and tested against your deployment.
# Do not accept funds until your deployment has been independently reviewed and tested.
CRYPTO_PAYMENTS_ENABLED=false
BSC_RPC_URL=
BSC_USDT_RECEIVING_ADDRESS=

# Verified platform owner; enable 2FA and sign in again before accessing admin.
PLATFORM_OWNER_EMAIL=

# Set false on API-only instances and run npm run workers on dedicated hosts.
# RUN_EMBEDDED_WORKERS=true
# Trust ONLY the exact IPs/CIDRs of your controlled reverse proxies. Never trust arbitrary clients.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
